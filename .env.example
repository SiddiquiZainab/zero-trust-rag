# Copy to .env and replace every placeholder before starting the API.
# Generate JWT_SECRET_KEY with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters

# Use three different, unique passwords (at least 12 characters each).
LOCAL_ALICE_PASSWORD=replace_with_unique_engineering_password
LOCAL_HR_PASSWORD=replace_with_unique_hr_password
LOCAL_ADMIN_PASSWORD=replace_with_unique_admin_password
